# API credentials
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional GPT-Live defaults
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
OPENAI_BACKEND_MODEL=gpt-5.6-luna

# Optional Shopify discovery defaults (no merchant token required)
SHOPIFY_COUNTRY=CA
SHOPIFY_CURRENCY=CAD
# Leave empty to use Combadge's hosted UCP capability profile.
SHOPIFY_AGENT_PROFILE_URL=
