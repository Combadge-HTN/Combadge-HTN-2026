# API credentials
OPENAI_API_KEY=
# Enables automatic web lookups in voice sessions; --no-web disables them.
BROWSERBASE_API_KEY=
# Optional cloud browser project; Browserbase can infer it from the API key.
BROWSERBASE_PROJECT_ID=

# Gmail and Google Calendar: enabled automatically when both settings are present.
# Use --no-composio to disable them for a voice session.
# Use the project key and exact user_id from: combadge composio accounts
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Optional: select one account if a user has multiple connections for that app.
COMPOSIO_GMAIL_ACCOUNT_ID=
COMPOSIO_GOOGLECALENDAR_ACCOUNT_ID=
COMBADGE_TIMEZONE=America/Toronto

# Optional GPT-Live defaults
OPENAI_LIVE_MODEL=gpt-live-1
# Built-in name, or an approved OpenAI custom voice ID (voice_...).
# A recording URL/file cannot be used here; see README.md "Custom speech voices".
OPENAI_LIVE_VOICE=marin
# Optional Majel RVC server; applied automatically to assistant speech on every start.
# Leave empty for the built-in voice. See docs/MAJEL.md for the separate Linux runtime.
COMBADGE_VOICE_CONVERSION_URL=
COMBADGE_VOICE_CONVERSION_TOKEN=
# Start the installed .majel runtime automatically (laptop only; false on QNX).
COMBADGE_VOICE_CONVERSION_AUTOSTART=false
OPENAI_BACKEND_MODEL=gpt-5.6-luna

# Direct phone calls: dedicated Twilio SIP trunk credentials
# Voice enables calls automatically when configured; use --no-calls to disable.
CALL_TRANSPORT=sip
CALL_SIP_DOMAIN=
CALL_SIP_USERNAME=
CALL_SIP_PASSWORD=
TWILIO_FROM_NUMBER=
# JSON name-to-E.164-number mapping, e.g. {"edmon":"+14165550123"}
CALL_CONTACTS={}
CALL_MAX_SECONDS=300

# Optional legacy relay transport (CALL_TRANSPORT=relay)
CALL_RELAY_URL=
CALL_RELAY_TOKEN=

# Account credentials for SMS and the optional legacy relay (not direct SIP calls)
CALL_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Text messaging: enabled automatically when credentials and SMS number are set.
# Use --no-sms to disable it for a voice session; combadge sms --help for CLI usage.
# Dedicated SMS-capable number; TWILIO_FROM_NUMBER remains the calling number.
TWILIO_FROM_NUMBER_TXT=
# Optional separate JSON contact map. Leave blank to reuse CALL_CONTACTS.
SMS_CONTACTS=
# Optional Shopify discovery defaults (no merchant token required)
SHOPIFY_COUNTRY=CA
SHOPIFY_CURRENCY=CAD
# Leave empty to use Combadge's hosted UCP capability profile.
SHOPIFY_AGENT_PROFILE_URL=
