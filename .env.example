# API credentials
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional GPT-Live defaults
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
OPENAI_BACKEND_MODEL=gpt-5.6-luna

# Phone client: relay address and a shared random token (32+ characters)
CALL_RELAY_URL=
CALL_RELAY_TOKEN=

# Phone relay only: keep Twilio credentials off the badge
CALL_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# JSON name-to-E.164-number mapping, e.g. {"alex":"+14165550123"}
CALL_CONTACTS={}
CALL_MAX_SECONDS=300
# Optional Shopify discovery defaults (no merchant token required)
SHOPIFY_COUNTRY=CA
SHOPIFY_CURRENCY=CAD
# Leave empty to use Combadge's hosted UCP capability profile.
SHOPIFY_AGENT_PROFILE_URL=
